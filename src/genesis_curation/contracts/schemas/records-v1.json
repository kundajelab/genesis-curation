{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "source__source": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "source"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "data": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "minLength": 1
            },
            "worker": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "snapshot": {
              "type": "string"
            },
            "media_type": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "location",
            "worker",
            "sha256",
            "snapshot",
            "media_type"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "data"
      ],
      "additionalProperties": false
    },
    "source": {
      "$ref": "#/$defs/source__source"
    },
    "invocation__invocation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "invocation"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "data": {
          "type": "object",
          "properties": {
            "provider_id": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "model_revision": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "serving_revision": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "task": {
              "type": "string"
            },
            "classification": {
              "enum": [
                "public",
                "internal",
                "local-only"
              ]
            },
            "source_hashes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "prompt_version": {
              "type": "string"
            },
            "schema_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "request_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "response": {},
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "response": {
                    "type": "string"
                  },
                  "error": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "status",
                  "response",
                  "error"
                ],
                "additionalProperties": false
              }
            },
            "status": {
              "enum": [
                "SUCCEEDED",
                "FAILED",
                "CANCELLED",
                "DISABLED"
              ]
            },
            "error": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latency_seconds": {
              "type": "number",
              "minimum": 0
            },
            "retry_count": {
              "type": "integer",
              "minimum": 0
            },
            "usage": {
              "type": "object",
              "properties": {
                "prompt_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "completion_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "total_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cost": {
                  "type": "null"
                }
              },
              "required": [
                "prompt_tokens",
                "completion_tokens",
                "total_tokens",
                "cost"
              ],
              "additionalProperties": false
            },
            "timestamp": {
              "type": "string"
            },
            "capabilities": {
              "type": "object"
            },
            "endpoint_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "client_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider_id",
            "model_id",
            "model_revision",
            "serving_revision",
            "task",
            "classification",
            "source_hashes",
            "prompt_version",
            "schema_hash",
            "request_hash",
            "response",
            "attempts",
            "status",
            "error",
            "latency_seconds",
            "retry_count",
            "usage",
            "timestamp",
            "capabilities",
            "endpoint_ref",
            "client_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "data"
      ],
      "additionalProperties": false
    },
    "invocation": {
      "$ref": "#/$defs/invocation__invocation"
    },
    "model_inspection__model_inspection": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "model_inspection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "data": {
          "type": "object",
          "properties": {
            "model_id": {
              "type": "string"
            },
            "requested_revision": {
              "type": "string"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "license": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "gated": {
              "type": "boolean"
            },
            "architecture": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "context_length": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "chat_template": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "weight_format": {
              "enum": [
                "safetensors",
                "unsafe",
                "unknown"
              ]
            },
            "weight_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "git_oid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "path",
                  "size",
                  "sha256",
                  "git_oid"
                ],
                "additionalProperties": false
              }
            },
            "source_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "retrieved_at": {
              "type": "string"
            },
            "runtime_compatibility": {
              "enum": [
                "UNVERIFIED",
                "VERIFIED"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "quantization": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "parameter_count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "selected_disk_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "model_id",
            "requested_revision",
            "revision",
            "license",
            "gated",
            "architecture",
            "context_length",
            "chat_template",
            "weight_format",
            "weight_bytes",
            "files",
            "source_hash",
            "retrieved_at",
            "runtime_compatibility",
            "limitations",
            "quantization",
            "parameter_count",
            "selected_disk_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "data"
      ],
      "additionalProperties": false
    },
    "model_inspection": {
      "$ref": "#/$defs/model_inspection__model_inspection"
    },
    "deployment__deployment": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "deployment"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "data": {
          "type": "object",
          "properties": {
            "plan_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "node_id": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "model_revision": {
              "type": "string"
            },
            "desired_state": {
              "enum": [
                "READY",
                "STOPPED"
              ]
            },
            "observed_state": {
              "enum": [
                "PLANNED",
                "STAGING",
                "STARTING",
                "READY",
                "UNHEALTHY",
                "UNKNOWN",
                "STOPPING",
                "STOPPED",
                "FAILED"
              ]
            },
            "container_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "endpoint": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reservations": {
              "type": "object"
            },
            "reason": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            }
          },
          "required": [
            "plan_hash",
            "node_id",
            "model_id",
            "model_revision",
            "desired_state",
            "observed_state",
            "container_id",
            "endpoint",
            "reservations",
            "reason",
            "updated"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "data"
      ],
      "additionalProperties": false
    },
    "deployment": {
      "$ref": "#/$defs/deployment__deployment"
    },
    "curation_event__curation_event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "curation_event"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string"
            },
            "operation": {
              "enum": [
                "import",
                "source",
                "proposal",
                "decision",
                "message",
                "example"
              ]
            },
            "parent": {
              "type": [
                "string",
                "null"
              ]
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "created": {
              "type": "string"
            },
            "payload": {
              "type": "object"
            }
          },
          "required": [
            "subject",
            "operation",
            "parent",
            "actor",
            "created",
            "payload"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "data"
      ]
    },
    "curation_event": {
      "$ref": "#/$defs/curation_event__curation_event"
    }
  }
}
