{
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "original": {},
          "value": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "status": {
            "enum": [
              "known",
              "unknown",
              "not_applicable",
              "conflicting"
            ]
          },
          "vocabulary_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "vocabulary_version": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_version": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "required": [
                "source_version",
                "locator",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "rationale": {
            "type": "string",
            "maxLength": 1000
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "field",
          "original",
          "value",
          "status",
          "vocabulary_id",
          "vocabulary_version",
          "evidence",
          "rationale",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fields"
  ],
  "additionalProperties": false
}
